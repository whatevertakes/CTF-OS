include README.md
include config.example.yaml
include config/model-routing.yaml
include sandbox/Dockerfile.sandbox
include sandbox/entrypoint.sh
include sandbox/sandbox-tools.txt
include scripts/normalize_sdist.py
recursive-include ctf_os/resources *.yaml Dockerfile.sandbox entrypoint.sh sandbox-tools.txt
graft knowledge
graft ctf_os/resources/knowledge
# Keep the pinned external knowledge manifest and MIT notice available in sdists.
recursive-include knowledge/external/ctf-skills *.md *.json LICENSE
recursive-include ctf_os/resources/knowledge/external/ctf-skills *.md *.json LICENSE
graft docs
graft tests

global-exclude __pycache__
global-exclude *.py[cod]
