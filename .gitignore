# Challenge input and canonical challenge state. .ctfos/ holds local state,
# benchmark manifests/receipts, and run artifacts; incoming/ holds untrusted
# challenge input. Neither directory is a tracked source of truth.
.ctfos/
incoming/

# Guard against accidentally creating bulk benchmark checkouts/results at the
# repository root. Supported local benchmark state belongs below .ctfos/.
/benchmarks/
/benchmark-results/

.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
