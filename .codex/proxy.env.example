# Copy is not required. Run `ctf-proxy-start`; it writes `.codex/proxy.env`
# with the current machine's Windows WSL vEthernet address.
export CTF_PROXY_HOST="172.28.240.1"
export CTF_PROXY_PORT="18086"
export CTF_PROXY_URL="http://${CTF_PROXY_HOST}:${CTF_PROXY_PORT}"
export HTTP_PROXY="$CTF_PROXY_URL"
export HTTPS_PROXY="$CTF_PROXY_URL"
export ALL_PROXY="$CTF_PROXY_URL"
export NO_PROXY="${NO_PROXY:-localhost,127.0.0.1,::1},${CTF_PROXY_HOST}"
