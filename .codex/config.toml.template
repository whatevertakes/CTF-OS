model = "gpt-5.5"
model_reasoning_effort = "xhigh"
plan_mode_reasoning_effort = "xhigh"
approval_policy = "never"
sandbox_mode = "danger-full-access"

[features]
goals = true
multi_agent = true
shell_snapshot = true
hooks = true

[shell_environment_policy]
set = { BASH_ENV = "__CTF_WORKSPACE_ROOT__/.codex/env.sh", CTF_WORKSPACE_ROOT = "__CTF_WORKSPACE_ROOT__", XDG_CACHE_HOME = "__CTF_WORKSPACE_ROOT__/.cache/xdg", MPLCONFIGDIR = "__CTF_WORKSPACE_ROOT__/.cache/matplotlib", NUMBA_CACHE_DIR = "__CTF_WORKSPACE_ROOT__/.cache/numba", PIP_CACHE_DIR = "__CTF_WORKSPACE_ROOT__/.cache/pip", UV_CACHE_DIR = "__CTF_WORKSPACE_ROOT__/.cache/uv", NPM_CONFIG_CACHE = "__CTF_WORKSPACE_ROOT__/.cache/npm", PYTHONPYCACHEPREFIX = "__CTF_WORKSPACE_ROOT__/.cache/python-pycache" }

[projects."__CTF_WORKSPACE_ROOT__"]
trust_level = "trusted"

[plugins."google-calendar@openai-curated"]
enabled = false

[plugins."canva@openai-curated-remote"]
enabled = false

[plugins."creative-production@openai-curated-remote"]
enabled = false

[plugins."data-analytics@openai-curated-remote"]
enabled = false

[plugins."figma@openai-curated-remote"]
enabled = false

[plugins."google-calendar@openai-curated-remote"]
enabled = false

[plugins."product-design@openai-curated-remote"]
enabled = false

[plugins."codex-security@openai-curated-remote"]
enabled = false

[plugins."github@openai-curated-remote"]
enabled = false

[plugins."notion@openai-curated"]
enabled = false

[mcp_servers.angr]
command = "angr-mcp"
args = ["--transport", "stdio"]
env = { FASTMCP_SHOW_SERVER_BANNER = "false", FASTMCP_LOG_LEVEL = "ERROR" }

[mcp_servers.playwright]
command = "npx"
args = ["-y", "@playwright/mcp@0.0.75"]

[mcp_servers.radare2]
command = "__CTF_WORKSPACE_ROOT__/.codex/bin/r2mcp-codex.sh"
