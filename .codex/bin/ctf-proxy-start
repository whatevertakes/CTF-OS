#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
POWERSHELL="/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe"
NETSH="/mnt/c/Windows/System32/netsh.exe"

if [ ! -x "$POWERSHELL" ] || [ ! -x "$NETSH" ]; then
  echo "FAIL Windows PowerShell/netsh not available from WSL" >&2
  exit 1
fi

wsl_host="$("$POWERSHELL" -NoProfile -Command \
  '($ip = Get-NetIPAddress -AddressFamily IPv4 | Where-Object { $_.InterfaceAlias -like "vEthernet*WSL*" } | Select-Object -First 1 -ExpandProperty IPAddress); if ($ip) { $ip } else { exit 1 }' \
  | tr -d '\r' | tail -n 1)"

if [ -z "$wsl_host" ]; then
  echo "FAIL could not determine Windows vEthernet WSL IPv4 address" >&2
  exit 1
fi

caido_ps1="$(mktemp --suffix=.ps1)"
trap 'rm -f "$caido_ps1"' EXIT
cat >"$caido_ps1" <<'PS1'
$ErrorActionPreference = "Stop"

function Find-CaidoCli {
  $candidates = @(
    "$env:LOCALAPPDATA\ctf-workspace\caido-cli\caido-cli.exe",
    "C:\Program Files\Caido\resources\bin\caido-cli.exe",
    "C:\Program Files (x86)\Caido\resources\bin\caido-cli.exe"
  )
  foreach ($candidate in $candidates) {
    if (Test-Path $candidate) { return $candidate }
  }
  $command = Get-Command caido-cli.exe -ErrorAction SilentlyContinue
  if ($command) { return $command.Source }
  return $null
}

function Install-CaidoCli {
  $installDir = "$env:LOCALAPPDATA\ctf-workspace\caido-cli"
  New-Item -ItemType Directory -Force -Path $installDir | Out-Null
  $release = (Invoke-WebRequest -UseBasicParsing -Uri "https://github.com/caido/caido/releases/latest").Content
  $pattern = 'https://caido\.download/releases/[^"<> ]+/caido-cli-[^"<> ]+-win-x86_64\.zip'
  $match = [regex]::Match($release, $pattern)
  if (-not $match.Success) {
    throw "Could not find latest Caido CLI Windows download URL"
  }
  $zip = Join-Path $env:TEMP "caido-cli-win-x86_64.zip"
  $extract = Join-Path $env:TEMP ("caido-cli-" + [guid]::NewGuid().ToString("N"))
  Invoke-WebRequest -UseBasicParsing -Uri $match.Value -OutFile $zip
  New-Item -ItemType Directory -Force -Path $extract | Out-Null
  Expand-Archive -Force -Path $zip -DestinationPath $extract
  $downloaded = Get-ChildItem -Path $extract -Filter "caido-cli.exe" -Recurse | Select-Object -First 1
  if (-not $downloaded) { throw "Downloaded Caido CLI archive did not contain caido-cli.exe" }
  Copy-Item -Force $downloaded.FullName (Join-Path $installDir "caido-cli.exe")
  Remove-Item -Force $zip -ErrorAction SilentlyContinue
  Remove-Item -Recurse -Force $extract -ErrorAction SilentlyContinue
  return Join-Path $installDir "caido-cli.exe"
}

$exe = Find-CaidoCli
if (-not $exe) {
  Write-Output "Caido CLI not found; installing latest Windows CLI to LOCALAPPDATA"
  $exe = Install-CaidoCli
}

$data = "$env:LOCALAPPDATA\Temp\caido-ctf-proxy"
New-Item -ItemType Directory -Force -Path $data | Out-Null
$listening = netstat -ano | Select-String "127.0.0.1:18086"
if (-not $listening) {
  Start-Process -FilePath $exe -ArgumentList @("--no-open","--no-sync","--allow-guests","--proxy-listen","127.0.0.1:18086","--ui-listen","127.0.0.1:18087","--data-path",$data) -WindowStyle Minimized
  Start-Sleep -Seconds 2
}
PS1
"$POWERSHELL" -NoProfile -ExecutionPolicy Bypass -File "$(wslpath -w "$caido_ps1")"

"$NETSH" interface portproxy delete v4tov4 "listenaddress=$wsl_host" listenport=18086 >/dev/null 2>&1 || true
"$NETSH" interface portproxy delete v4tov4 "listenaddress=$wsl_host" listenport=18087 >/dev/null 2>&1 || true
"$NETSH" interface portproxy add v4tov4 "listenaddress=$wsl_host" listenport=18086 connectaddress=127.0.0.1 connectport=18086 >/dev/null
"$NETSH" interface portproxy add v4tov4 "listenaddress=$wsl_host" listenport=18087 connectaddress=127.0.0.1 connectport=18087 >/dev/null

"$POWERSHELL" -NoProfile -Command \
  'foreach ($p in 18086,18087) {
     $name = "CTF Proxy $p";
     if (-not (Get-NetFirewallRule -DisplayName $name -ErrorAction SilentlyContinue)) {
       New-NetFirewallRule -DisplayName $name -Direction Inbound -Action Allow -Protocol TCP -LocalPort $p | Out-Null
     }
   }'

cat >"$ROOT/.codex/proxy.env" <<EOF
# Source this file only when you want WSL CLI traffic to go through the
# Windows Caido CTF proxy bridge.
export CTF_PROXY_HOST="${wsl_host}"
export CTF_PROXY_PORT="18086"
export CTF_PROXY_URL="http://${wsl_host}:18086"
export HTTP_PROXY="\$CTF_PROXY_URL"
export HTTPS_PROXY="\$CTF_PROXY_URL"
export ALL_PROXY="\$CTF_PROXY_URL"
export NO_PROXY="\${NO_PROXY:-localhost,127.0.0.1,::1},${wsl_host}"
EOF

echo "PASS Caido CTF proxy bridge"
echo "UI:    http://${wsl_host}:18087"
echo "Proxy: http://${wsl_host}:18086"
echo "Use:   . .codex/proxy.env"
echo "Note:  Open the UI and create/select a Caido project before proxying requests."
