#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
POWERSHELL="/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe"
NETSH="/mnt/c/Windows/System32/netsh.exe"

if [ ! -x "$POWERSHELL" ] || [ ! -x "$NETSH" ]; then
  echo "FAIL Windows PowerShell/netsh not available from WSL" >&2
  exit 1
fi

wsl_host="$("$POWERSHELL" -NoProfile -Command \
  '($ip = Get-NetIPAddress -AddressFamily IPv4 | Where-Object { $_.InterfaceAlias -like "vEthernet*WSL*" } | Select-Object -First 1 -ExpandProperty IPAddress); if ($ip) { $ip } else { exit 1 }' \
  | tr -d '\r' | tail -n 1)"

if [ -z "$wsl_host" ]; then
  echo "FAIL could not determine Windows vEthernet WSL IPv4 address" >&2
  exit 1
fi

"$POWERSHELL" -NoProfile -Command \
  '$exe="C:\Program Files\Caido\resources\bin\caido-cli.exe";
   if (-not (Test-Path $exe)) { Write-Error "Caido CLI not found"; exit 1 }
   $data="$env:LOCALAPPDATA\Temp\caido-ctf-proxy";
   New-Item -ItemType Directory -Force -Path $data | Out-Null;
   $listening = netstat -ano | Select-String "127.0.0.1:18086";
   if (-not $listening) {
     Start-Process -FilePath $exe -ArgumentList @("--no-open","--no-sync","--allow-guests","--proxy-listen","127.0.0.1:18086","--ui-listen","127.0.0.1:18087","--data-path",$data) -WindowStyle Minimized;
     Start-Sleep -Seconds 2;
   }'

"$NETSH" interface portproxy delete v4tov4 "listenaddress=$wsl_host" listenport=18086 >/dev/null 2>&1 || true
"$NETSH" interface portproxy delete v4tov4 "listenaddress=$wsl_host" listenport=18087 >/dev/null 2>&1 || true
"$NETSH" interface portproxy add v4tov4 "listenaddress=$wsl_host" listenport=18086 connectaddress=127.0.0.1 connectport=18086 >/dev/null
"$NETSH" interface portproxy add v4tov4 "listenaddress=$wsl_host" listenport=18087 connectaddress=127.0.0.1 connectport=18087 >/dev/null

"$POWERSHELL" -NoProfile -Command \
  'foreach ($p in 18086,18087) {
     $name = "CTF Proxy $p";
     if (-not (Get-NetFirewallRule -DisplayName $name -ErrorAction SilentlyContinue)) {
       New-NetFirewallRule -DisplayName $name -Direction Inbound -Action Allow -Protocol TCP -LocalPort $p | Out-Null
     }
   }'

cat >"$ROOT/.codex/proxy.env" <<EOF
# Source this file only when you want WSL CLI traffic to go through the
# Windows Caido CTF proxy bridge.
export CTF_PROXY_HOST="${wsl_host}"
export CTF_PROXY_PORT="18086"
export CTF_PROXY_URL="http://${wsl_host}:18086"
export HTTP_PROXY="\$CTF_PROXY_URL"
export HTTPS_PROXY="\$CTF_PROXY_URL"
export ALL_PROXY="\$CTF_PROXY_URL"
export NO_PROXY="\${NO_PROXY:-localhost,127.0.0.1,::1}"
EOF

echo "PASS Caido CTF proxy bridge"
echo "UI:    http://${wsl_host}:18087"
echo "Proxy: http://${wsl_host}:18086"
echo "Use:   . .codex/proxy.env"
echo "Note:  Open the UI and create/select a Caido project before proxying requests."
