#!/usr/bin/env bash
set -euo pipefail

host="${CTF_PROXY_HOST:-172.28.240.1}"
proxy_port="${CTF_PROXY_PORT:-18086}"
ui_port="${CTF_PROXY_UI_PORT:-18087}"

echo "UI http://${host}:${ui_port}/"
curl --noproxy "*" -sS --max-time 5 -o /tmp/ctf_proxy_ui_body -w "ui_http=%{http_code}\n" "http://${host}:${ui_port}/" || true

echo "Proxy http://${host}:${proxy_port}/ -> http://example.com/"
curl -sS --max-time 8 -x "http://${host}:${proxy_port}" -D /tmp/ctf_proxy_headers -o /tmp/ctf_proxy_body http://example.com/ || true
sed -n '1,8p' /tmp/ctf_proxy_headers 2>/dev/null || true
if rg -q "Have you tried selecting a project first|Could not acquire a connection to the database|Proxy encountered an unhandled error" /tmp/ctf_proxy_body 2>/dev/null; then
  echo "WARN Caido is reachable, but the Caido instance/project repository is not ready."
  echo "WARN In the UI, select the running Caido instance first; create/select a project only if the UI asks for one."
fi
if rg -q "Example Domain" /tmp/ctf_proxy_body 2>/dev/null; then
  echo "PASS Caido proxy forwarded example.com"
fi
rm -f /tmp/ctf_proxy_ui_body /tmp/ctf_proxy_headers /tmp/ctf_proxy_body
