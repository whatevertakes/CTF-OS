{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CTF-OS Claude Rescue Return",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "rescue_attempt_id", "run_id", "challenge_instance_id",
    "input_fingerprint", "target_revision", "packet_digest", "requested_lead_model",
    "observed_lead_model", "runtime_observation_evidence", "fallback_observed",
    "verdict", "summary", "verified_observations", "new_attack_path",
    "decisive_experiments", "artifacts", "remote_ready", "flag_claim", "message_for_codex"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "rescue_attempt_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "challenge_instance_id": {"type": "string", "minLength": 1},
    "input_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_revision": {"type": "integer", "minimum": 1},
    "packet_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requested_lead_model": {"type": "string", "minLength": 1},
    "observed_lead_model": {"type": ["string", "null"]},
    "runtime_observation_evidence": {"type": ["string", "null"]},
    "fallback_observed": {"type": ["boolean", "null"]},
    "verdict": {"enum": ["REMOTE_FLAG_OBTAINED", "REMOTE_READY_HANDOFF", "CONFIRMED_BREAKTHROUGH", "NO_NEW_PATH", "ERROR"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 8000},
    "verified_observations": {"type": "array", "maxItems": 100},
    "new_attack_path": {"type": "string", "maxLength": 8000},
    "decisive_experiments": {"type": "array", "maxItems": 20},
    "artifacts": {
      "type": "array",
      "maxItems": 200,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "remote_ready": {"type": ["object", "null"]},
    "flag_claim": {"type": ["object", "null"]},
    "message_for_codex": {"type": "string", "maxLength": 8000}
  },
  "$defs": {
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"type": "string", "minLength": 1}
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "executable": {"type": "boolean"},
        "description": {"type": "string", "maxLength": 2000}
      }
    },
    "remote_ready": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "exploit_artifact", "exact_next_argv", "target_index", "success_condition", "kill_condition", "maximum_remaining_experiments"],
      "properties": {
        "value": {"const": true},
        "exploit_artifact": {"type": "string", "minLength": 1},
        "exact_next_argv": {"$ref": "#/$defs/argv"},
        "target_index": {"type": "integer", "minimum": 0},
        "success_condition": {"type": "string", "minLength": 1, "maxLength": 2000},
        "kill_condition": {"type": "string", "minLength": 1, "maxLength": 2000},
        "maximum_remaining_experiments": {"type": "integer", "minimum": 1, "maximum": 3}
      }
    },
    "flag_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "command_receipt_id", "exploit_artifact"],
      "properties": {
        "candidate": {"type": "string", "minLength": 1},
        "command_receipt_id": {"type": "string", "minLength": 1},
        "exploit_artifact": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "REMOTE_FLAG_OBTAINED"}}},
      "then": {
        "properties": {
          "flag_claim": {"$ref": "#/$defs/flag_claim"}
        }
      }
    },
    {
      "if": {"properties": {"verdict": {"const": "REMOTE_READY_HANDOFF"}}},
      "then": {
        "properties": {
          "remote_ready": {"$ref": "#/$defs/remote_ready"},
          "artifacts": {"type": "array", "minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"verdict": {"const": "CONFIRMED_BREAKTHROUGH"}}},
      "then": {
        "properties": {
          "decisive_experiments": {"type": "array", "minItems": 1}
        }
      }
    }
  ]
}
