#!/bin/sh
set -eu

# Cargo needs a writable home even though the sandbox root filesystem is
# read-only. Docker build-time smoke tests run as root, so they must not leave a
# root-owned config under /work that the runtime ctf user cannot read.
if [ -n "${CARGO_HOME:-}" ]; then
  runtime_cargo_home="$CARGO_HOME"
elif [ "$(id -u)" -eq 0 ]; then
  runtime_cargo_home="/tmp/ctf-os-build-cargo"
else
  runtime_cargo_home="/work/home/.cargo"
fi
mkdir -p "$runtime_cargo_home"
if [ ! -e "$runtime_cargo_home/config.toml" ]; then
  umask 077
  {
    printf '%s\n' '[source.crates-io]'
    printf '%s\n' 'replace-with = "ctf-os-vendored"'
    printf '%s\n' '[source.ctf-os-vendored]'
    printf '%s\n' 'directory = "/opt/cargo-fuzz-vendor"'
    printf '%s\n' '[net]'
    printf '%s\n' 'offline = true'
  } >"$runtime_cargo_home/config.toml"
fi

export CARGO_HOME="$runtime_cargo_home"
export CARGO_NET_OFFLINE=true
exec /opt/rust-toolchain/bin/cargo "$@"
