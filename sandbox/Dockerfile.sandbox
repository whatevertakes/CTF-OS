# syntax=docker/dockerfile:1.7
# Single source of truth for CTF_OS_PROFILE=base|pwn|web|rev|crypto|forensic|misc|osint|ai|cloud.
ARG CTF_OS_PROFILE=base
FROM debian:12-slim@sha256:60eac759739651111db372c07be67863818726f754804b8707c90979bda511df AS common

ENV DEBIAN_FRONTEND=noninteractive \
    TERM=xterm-256color \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

COPY sandbox/requirements.txt /opt/ctf-os/requirements/common.txt
COPY sandbox/requirements-lock/common.txt /opt/ctf-os/requirements-lock/common.txt
COPY sandbox/apt-snapshot.lock /opt/ctf-os/apt-snapshot.lock
COPY sandbox/install/apt-snapshot.sh sandbox/install/lib.sh sandbox/install/common.sh /opt/ctf-os/install/
RUN chmod 0755 /opt/ctf-os/install/*.sh \
    && /opt/ctf-os/install/apt-snapshot.sh \
    && /opt/ctf-os/install/common.sh

RUN groupadd --gid 1001 ctf \
    && useradd --uid 1001 --gid 1001 --create-home --shell /bin/bash ctf \
    && mkdir -p /challenge /work /artifacts \
    && chown ctf:ctf /work /artifacts

WORKDIR /challenge

FROM rust:1.85.1-slim-bookworm@sha256:9f841bbe9e7d8e37ceb96ed907265a3a0df7f44e3737d0b100e7907a679acb36 AS ares-builder
ARG ARES_COMMIT=f0df3efa0272bbc7c1b8fa14f06b6104fdd287d1
ARG ARES_SHA256=c9c2d831eec10a032afb846d751ada575fc3c880fa790e4ae01a69a8375fa183
COPY sandbox/apt-snapshot.lock /opt/ctf-os/apt-snapshot.lock
COPY sandbox/install/apt-snapshot.sh /opt/ctf-os/apt-snapshot.sh
RUN chmod 0755 /opt/ctf-os/apt-snapshot.sh \
    && /opt/ctf-os/apt-snapshot.sh \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && curl --fail --location --retry 3 --silent --show-error \
       "https://github.com/bee-san/Ares/archive/${ARES_COMMIT}.tar.gz" \
       --output /tmp/ares.tar.gz \
    && echo "${ARES_SHA256}  /tmp/ares.tar.gz" | sha256sum -c - \
    && mkdir /tmp/ares \
    && tar -xzf /tmp/ares.tar.gz -C /tmp/ares --strip-components=1 \
    && cargo build --manifest-path /tmp/ares/Cargo.toml --release --locked

FROM swift:6.3.3-bookworm@sha256:508b05bbc3919a1d392e57f3ddd13aed2793566c8111d750feeff6ba7e468ffb AS fuzzilli-builder
COPY sandbox/install/fuzzilli-builder.sh /usr/local/bin/fuzzilli-builder
RUN chmod 0755 /usr/local/bin/fuzzilli-builder \
    && /usr/local/bin/fuzzilli-builder
COPY sandbox/install/fuzzilli-jerryscript-builder.sh /usr/local/bin/fuzzilli-jerryscript-builder
RUN chmod 0755 /usr/local/bin/fuzzilli-jerryscript-builder \
    && /usr/local/bin/fuzzilli-jerryscript-builder

FROM mcr.microsoft.com/dotnet/sdk:8.0.414-bookworm-slim@sha256:10b82617ed77a869847f0dea7d4ddf528b694d68636fcd05bc87574b653f9bdd AS restler-builder
COPY sandbox/install/restler-builder.sh /usr/local/bin/restler-builder
RUN chmod 0755 /usr/local/bin/restler-builder \
    && /usr/local/bin/restler-builder

FROM common AS profile-base

FROM common AS binary-analysis
ENV JAVA_HOME=/opt/java \
    GHIDRA_HOME=/opt/ghidra \
    CAPA_RULES=/opt/capa-rules \
    PATH=/opt/java/bin:/opt/ghidra/support:/opt/ghidra:${PATH}
COPY sandbox/requirements/binary-analysis.txt /opt/ctf-os/requirements/binary-analysis.txt
COPY sandbox/requirements-lock/binary-analysis.txt /opt/ctf-os/requirements-lock/binary-analysis.txt
COPY sandbox/install/binary-analysis.sh /opt/ctf-os/install/binary-analysis.sh
COPY sandbox/bin/ctf-ghidra-headless /usr/local/bin/ctf-ghidra-headless
COPY sandbox/bin/capa /usr/local/bin/capa
COPY sandbox/ghidra/ExportDecompilation.java /opt/ctf-os/ghidra-scripts/ExportDecompilation.java
COPY sandbox/smoke/binary-analysis.sh /usr/local/bin/ctf-os-binary-analysis-smoke
RUN chmod 0755 /opt/ctf-os/install/binary-analysis.sh \
        /usr/local/bin/capa /usr/local/bin/ctf-ghidra-headless \
        /usr/local/bin/ctf-os-binary-analysis-smoke \
    && /opt/ctf-os/install/binary-analysis.sh

FROM binary-analysis AS pwn-tools
COPY sandbox/requirements/pwn.txt /opt/ctf-os/requirements/pwn.txt
COPY sandbox/requirements-lock/pwn.txt /opt/ctf-os/requirements-lock/pwn.txt
COPY sandbox/install/binary-runtime.sh sandbox/install/pwn.sh /opt/ctf-os/install/
COPY sandbox/smoke/binary-runtime.sh /usr/local/bin/ctf-os-binary-runtime-smoke
RUN chmod 0755 /opt/ctf-os/install/*.sh /usr/local/bin/ctf-os-binary-runtime-smoke \
    && /opt/ctf-os/install/pwn.sh
COPY sandbox/install/pwn-fuzzing.sh /opt/ctf-os/install/pwn-fuzzing.sh
RUN chmod 0755 /opt/ctf-os/install/pwn-fuzzing.sh \
    && /opt/ctf-os/install/pwn-fuzzing.sh
COPY sandbox/install/pwn-network-fuzzing.sh /opt/ctf-os/install/pwn-network-fuzzing.sh
RUN chmod 0755 /opt/ctf-os/install/pwn-network-fuzzing.sh \
    && /opt/ctf-os/install/pwn-network-fuzzing.sh
COPY sandbox/bin/aflnet-fuzz sandbox/bin/aflnet-clang-fast sandbox/bin/aflnet-replay \
    sandbox/bin/stateafl-fuzz sandbox/bin/stateafl-clang-fast sandbox/bin/stateafl-replay \
    /usr/local/bin/
RUN chmod 0755 \
    /usr/local/bin/aflnet-fuzz /usr/local/bin/aflnet-clang-fast /usr/local/bin/aflnet-replay \
    /usr/local/bin/stateafl-fuzz /usr/local/bin/stateafl-clang-fast /usr/local/bin/stateafl-replay
ENV PATH=/usr/local/bin:/opt/rust-toolchain/bin:${PATH}
COPY sandbox/requirements/pwn-fuzzing.txt /opt/ctf-os/requirements/pwn-fuzzing.txt
COPY sandbox/requirements-lock/pwn-fuzzing.txt /opt/ctf-os/requirements-lock/pwn-fuzzing.txt
COPY sandbox/install/pwn-analysis-fuzzing.sh /opt/ctf-os/install/pwn-analysis-fuzzing.sh
RUN chmod 0755 /opt/ctf-os/install/pwn-analysis-fuzzing.sh \
    && /opt/ctf-os/install/pwn-analysis-fuzzing.sh
COPY sandbox/install/pwn-language-fuzzing.sh /opt/ctf-os/install/pwn-language-fuzzing.sh
COPY sandbox/bin/ctf-cargo /usr/local/bin/cargo
RUN chmod 0755 /opt/ctf-os/install/pwn-language-fuzzing.sh /usr/local/bin/cargo \
    && /opt/ctf-os/install/pwn-language-fuzzing.sh
COPY sandbox/install/pwn-advanced-fuzzing.sh /opt/ctf-os/install/pwn-advanced-fuzzing.sh
RUN chmod 0755 /opt/ctf-os/install/pwn-advanced-fuzzing.sh \
    && /opt/ctf-os/install/pwn-advanced-fuzzing.sh
COPY sandbox/install/pwn-libafl.sh /opt/ctf-os/install/pwn-libafl.sh
RUN chmod 0755 /opt/ctf-os/install/pwn-libafl.sh \
    && /opt/ctf-os/install/pwn-libafl.sh

FROM pwn-tools AS profile-pwn
COPY sandbox/smoke/pwn-fuzzing.sh /usr/local/bin/ctf-os-pwn-fuzzing-smoke
RUN chmod 0755 /usr/local/bin/ctf-os-pwn-fuzzing-smoke \
    && /usr/local/bin/ctf-os-pwn-fuzzing-smoke

FROM common AS web-tools
ENV NUCLEI_TEMPLATES=/opt/nuclei-templates \
    DISABLE_NUCLEI_TEMPLATES_PUBLIC_DOWNLOAD=true \
    DISABLE_NUCLEI_TEMPLATES_GITHUB_DOWNLOAD=true \
    DISABLE_NUCLEI_TEMPLATES_GITLAB_DOWNLOAD=true \
    DISABLE_NUCLEI_TEMPLATES_AWS_DOWNLOAD=true \
    DISABLE_NUCLEI_TEMPLATES_AZURE_DOWNLOAD=true
COPY sandbox/requirements/web.txt /opt/ctf-os/requirements/web.txt
COPY sandbox/requirements-lock/web.txt /opt/ctf-os/requirements-lock/web.txt
COPY sandbox/requirements-lock/isolated/semgrep.txt /opt/ctf-os/requirements-lock/isolated/semgrep.txt
COPY sandbox/requirements-lock/isolated/mitmproxy.txt /opt/ctf-os/requirements-lock/isolated/mitmproxy.txt
COPY sandbox/requirements-lock/isolated/jwt-tool.txt /opt/ctf-os/requirements-lock/isolated/jwt-tool.txt
COPY sandbox/install/web.sh sandbox/install/web-verify.sh /opt/ctf-os/install/
COPY sandbox/smoke/web-runtime.py /usr/local/bin/ctf-os-web-runtime-smoke
COPY sandbox/bin/ctf-nuclei-scan sandbox/bin/sstimap sandbox/bin/jwt-tool \
    sandbox/bin/commix sandbox/bin/ysoserial /usr/local/bin/
COPY sandbox/rules/nuclei /opt/ctf-os/rules/nuclei
COPY sandbox/rules/semgrep /opt/ctf-os/rules/semgrep
RUN chmod 0755 /usr/local/bin/ctf-os-web-runtime-smoke /usr/local/bin/ctf-nuclei-scan \
        /usr/local/bin/sstimap /usr/local/bin/jwt-tool /usr/local/bin/commix \
        /usr/local/bin/ysoserial \
    && /opt/ctf-os/install/web.sh
RUN chmod 0755 /opt/ctf-os/install/web-verify.sh \
    && /opt/ctf-os/install/web-verify.sh

FROM web-tools AS profile-web
COPY --from=restler-builder /opt/restler /opt/restler
COPY --from=restler-builder /usr/share/dotnet/dotnet /usr/share/dotnet/dotnet
COPY --from=restler-builder /usr/share/dotnet/host /usr/share/dotnet/host
COPY --from=restler-builder /usr/share/dotnet/shared/Microsoft.NETCore.App /usr/share/dotnet/shared/Microsoft.NETCore.App
COPY sandbox/bin/restler /usr/local/bin/restler
COPY sandbox/smoke/web-security.sh /usr/local/bin/ctf-os-web-security-smoke
RUN chmod 0755 /usr/local/bin/ctf-os-web-security-smoke /usr/local/bin/sstimap /usr/local/bin/restler \
    && /usr/local/bin/ctf-os-web-security-smoke

FROM binary-analysis AS profile-rev
COPY sandbox/requirements/rev.txt /opt/ctf-os/requirements/rev.txt
COPY sandbox/requirements-lock/rev.txt /opt/ctf-os/requirements-lock/rev.txt
COPY sandbox/install/binary-runtime.sh sandbox/install/rev.sh /opt/ctf-os/install/
COPY sandbox/bin/apktool /usr/local/bin/apktool
COPY sandbox/smoke/binary-runtime.sh /usr/local/bin/ctf-os-binary-runtime-smoke
COPY sandbox/smoke/system-qemu.sh /usr/local/bin/ctf-os-system-qemu-smoke
RUN chmod 0755 /opt/ctf-os/install/*.sh /usr/local/bin/ctf-os-*-smoke /usr/local/bin/apktool \
    && /opt/ctf-os/install/rev.sh
COPY sandbox/install/rev-fuzzing.sh /opt/ctf-os/install/rev-fuzzing.sh
COPY sandbox/smoke/rev-fuzzing.sh /usr/local/bin/ctf-os-rev-fuzzing-smoke
COPY --from=fuzzilli-builder /opt/fuzzilli /opt/fuzzilli
COPY --from=fuzzilli-builder /usr/lib/swift/linux /usr/lib/swift/linux
COPY sandbox/bin/fuzzilli sandbox/bin/fuzzil-tool /usr/local/bin/
RUN chmod 0755 /opt/ctf-os/install/rev-fuzzing.sh /usr/local/bin/ctf-os-rev-fuzzing-smoke \
        /usr/local/bin/fuzzilli /usr/local/bin/fuzzil-tool \
    && ln -s /opt/fuzzilli/bin/jerry-fuzzilli /usr/local/bin/jerry-fuzzilli \
    && /opt/ctf-os/install/rev-fuzzing.sh \
    && /usr/local/bin/ctf-os-rev-fuzzing-smoke

FROM common AS profile-crypto
COPY sandbox/requirements/crypto.txt /opt/ctf-os/requirements/crypto.txt
COPY sandbox/requirements-lock/crypto.txt /opt/ctf-os/requirements-lock/crypto.txt
COPY sandbox/requirements-lock/cuda-nvrtc.txt /opt/ctf-os/requirements-lock/cuda-nvrtc.txt
COPY sandbox/requirements-lock/isolated/rsactftool.txt /opt/ctf-os/requirements-lock/isolated/rsactftool.txt
COPY sandbox/install/crypto.sh /opt/ctf-os/install/crypto.sh
COPY --from=ares-builder /tmp/ares/target/release/ares /usr/local/bin/ares
RUN /opt/ctf-os/install/crypto.sh
RUN sage -c 'assert 2^10 == 1024; assert GF(7)(3)^2 == 2'

FROM common AS profile-forensic
COPY sandbox/requirements/forensic.txt /opt/ctf-os/requirements/forensic.txt
COPY sandbox/requirements-lock/forensic.txt /opt/ctf-os/requirements-lock/forensic.txt
COPY sandbox/install/forensic.sh /opt/ctf-os/install/forensic.sh
RUN /opt/ctf-os/install/forensic.sh

FROM common AS profile-misc
COPY sandbox/requirements/misc.txt /opt/ctf-os/requirements/misc.txt
COPY sandbox/requirements-lock/misc.txt /opt/ctf-os/requirements-lock/misc.txt
COPY sandbox/requirements-lock/torch-cpu.txt /opt/ctf-os/requirements-lock/torch-cpu.txt
COPY sandbox/install/misc.sh /opt/ctf-os/install/misc.sh
COPY --from=ares-builder /tmp/ares/target/release/ares /usr/local/bin/ares
RUN /opt/ctf-os/install/misc.sh

FROM common AS profile-osint
COPY sandbox/requirements/osint.txt /opt/ctf-os/requirements/osint.txt
COPY sandbox/requirements-lock/osint.txt /opt/ctf-os/requirements-lock/osint.txt
COPY sandbox/requirements-lock/isolated/sherlock.txt /opt/ctf-os/requirements-lock/isolated/sherlock.txt
COPY sandbox/requirements-lock/isolated/maigret.txt /opt/ctf-os/requirements-lock/isolated/maigret.txt
COPY sandbox/requirements-lock/isolated/holehe.txt /opt/ctf-os/requirements-lock/isolated/holehe.txt
COPY sandbox/requirements-lock/isolated/theharvester.txt /opt/ctf-os/requirements-lock/isolated/theharvester.txt
COPY sandbox/install/osint.sh /opt/ctf-os/install/osint.sh
RUN /opt/ctf-os/install/osint.sh

FROM common AS ai-tools
COPY sandbox/requirements/ai.txt /opt/ctf-os/requirements/ai.txt
COPY sandbox/requirements-lock/ai.txt /opt/ctf-os/requirements-lock/ai.txt
COPY sandbox/requirements-lock/torch-cu126.txt /opt/ctf-os/requirements-lock/torch-cu126.txt
COPY sandbox/install/ai.sh /opt/ctf-os/install/ai.sh
RUN /opt/ctf-os/install/ai.sh
COPY sandbox/requirements/ai-security.txt /opt/ctf-os/requirements/ai-security.txt
COPY sandbox/requirements-lock/ai-security.txt /opt/ctf-os/requirements-lock/ai-security.txt
COPY sandbox/install/ai-security.sh /opt/ctf-os/install/ai-security.sh
RUN chmod 0755 /opt/ctf-os/install/ai-security.sh \
    && /opt/ctf-os/install/ai-security.sh

FROM ai-tools AS profile-ai
COPY sandbox/install/ai-security-verify.sh /opt/ctf-os/install/ai-security-verify.sh
COPY sandbox/smoke/ai-serialization.py /usr/local/bin/ctf-os-ai-serialization-smoke
RUN chmod 0755 /usr/local/bin/ctf-os-ai-serialization-smoke \
        /opt/ctf-os/install/ai-security-verify.sh \
    && /opt/ctf-os/install/ai-security-verify.sh

FROM common AS profile-cloud
COPY sandbox/requirements/cloud.txt /opt/ctf-os/requirements/cloud.txt
COPY sandbox/requirements-lock/cloud.txt /opt/ctf-os/requirements-lock/cloud.txt
COPY sandbox/requirements-lock/isolated/checkov.txt /opt/ctf-os/requirements-lock/isolated/checkov.txt
COPY sandbox/requirements-lock/isolated/semgrep.txt /opt/ctf-os/requirements-lock/isolated/semgrep.txt
COPY sandbox/install/cloud.sh /opt/ctf-os/install/cloud.sh
RUN /opt/ctf-os/install/cloud.sh

FROM profile-${CTF_OS_PROFILE} AS final
ARG CTF_OS_PROFILE
ARG CTF_OS_LOCK_SHA256
ARG CTF_OS_BUILD_SHA256
COPY sandbox/sandbox-tools.txt /tools.txt
COPY sandbox/tool-versions.lock /opt/ctf-os/tool-versions.lock
COPY sandbox/config/ares.toml /opt/ctf-os/ares-config.toml
COPY sandbox/pip-check-allowlists /opt/ctf-os/pip-check-allowlists
COPY sandbox/install/verify-python.sh /opt/ctf-os/install/verify-python.sh
COPY sandbox/entrypoint.sh /usr/local/bin/ctf-os-entrypoint
RUN chmod 0755 /usr/local/bin/ctf-os-entrypoint /opt/ctf-os/install/verify-python.sh \
    && /opt/ctf-os/install/verify-python.sh "${CTF_OS_PROFILE}" \
    && mkdir -p /opt/ctf-os/resolved \
    && LC_ALL=C dpkg-query --show --showformat='${Package}=${Version}\n' \
       | LC_ALL=C sort > /opt/ctf-os/resolved/apt.txt \
    && python3 -m pip freeze --all \
       | LC_ALL=C sort > /opt/ctf-os/resolved/python.txt \
    && : > /opt/ctf-os/resolved/python-venvs.txt \
    && for config in $(find /opt -mindepth 2 -maxdepth 2 -name pyvenv.cfg \
         -print | LC_ALL=C sort); do \
         venv="${config%/pyvenv.cfg}"; \
         "$venv/bin/python" -m pip check || exit 1; \
         printf '[%s]\n' "$venv" >> /opt/ctf-os/resolved/python-venvs.txt; \
         "$venv/bin/python" -m pip freeze --all \
           | LC_ALL=C sort >> /opt/ctf-os/resolved/python-venvs.txt; \
       done \
    && cd /opt/ctf-os/resolved \
    && sha256sum apt.txt python.txt python-venvs.txt > SHA256SUMS
LABEL org.ctf-os.sandbox="true" \
      org.ctf-os.profile="${CTF_OS_PROFILE}" \
      org.ctf-os.build-policy="pre-contest-pinned" \
      org.ctf-os.lock-sha256="${CTF_OS_LOCK_SHA256}" \
      org.ctf-os.build-sha256="${CTF_OS_BUILD_SHA256}"
ENTRYPOINT ["/usr/local/bin/ctf-os-entrypoint"]
CMD ["sleep", "infinity"]
