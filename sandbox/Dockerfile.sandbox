# One source-of-truth image. Build the default practical base with:
# docker build -f sandbox/Dockerfile.sandbox -t ctf-os-sandbox:latest .
# Optional tools: --build-arg CTF_OS_PROFILE=rev-heavy|crypto-heavy|forensic-heavy.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive TERM=xterm PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      bash ca-certificates curl netcat-openbsd socat jq \
      file binutils xxd unzip zip p7zip-full \
      gdb gdb-multiarch ltrace strace \
      gcc g++ make python3 python3-pip python3-venv \
      openssl iptables util-linux procps \
    && rm -rf /var/lib/apt/lists/*

COPY sandbox/requirements.txt /tmp/requirements.txt
RUN python3 -m pip install --break-system-packages --no-cache-dir -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

ARG CTF_OS_PROFILE=base
RUN case "$CTF_OS_PROFILE" in \
      base) ;; \
      rev-heavy) packages="radare2 default-jre-headless" ;; \
      crypto-heavy) packages="sagemath" ;; \
      forensic-heavy) packages="binwalk exiftool sleuthkit foremost testdisk tshark ffmpeg imagemagick" ;; \
      *) echo "unknown CTF_OS_PROFILE: $CTF_OS_PROFILE" >&2; exit 64 ;; \
    esac \
    && if [ -n "${packages:-}" ]; then \
         apt-get update \
         && apt-get install -y --no-install-recommends $packages \
         && rm -rf /var/lib/apt/lists/*; \
       fi

COPY sandbox/sandbox-tools.txt /tools.txt
RUN groupadd --gid 1001 ctf \
    && useradd --uid 1001 --gid 1001 --create-home --shell /bin/bash ctf \
    && mkdir -p /challenge /work /artifacts \
    && chown ctf:ctf /work /artifacts
COPY sandbox/entrypoint.sh /usr/local/bin/ctf-os-entrypoint
RUN chmod 0755 /usr/local/bin/ctf-os-entrypoint

WORKDIR /challenge
ENTRYPOINT ["/usr/local/bin/ctf-os-entrypoint"]
CMD ["sleep", "infinity"]
