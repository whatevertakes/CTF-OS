# Optional tactical profile stages. The broad legacy image remains a compatible
# base while deployments can build only the stages they need.
ARG BASE_IMAGE=ctf-os-sandbox:latest
FROM ${BASE_IMAGE} AS base

FROM base AS pwn
ARG PWNINIT_VERSION=3.3.1
ARG PWNINIT_SHA256=1b72653be59f8f13ea934d1153e8d845eac0dbac62a8c4d9dc4a25577f009362
RUN apt-get update && apt-get install -y --no-install-recommends patchelf \
    && curl -fsSL "https://github.com/io12/pwninit/releases/download/${PWNINIT_VERSION}/pwninit" -o /usr/local/bin/pwninit \
    && echo "${PWNINIT_SHA256}  /usr/local/bin/pwninit" | sha256sum -c - \
    && chmod 0755 /usr/local/bin/pwninit \
    && rm -rf /var/lib/apt/lists/*

FROM base AS web
ARG NUCLEI_VERSION=3.8.0
ARG NUCLEI_SHA256=cd4ea43c88b50af8ab96eb6ad3fb4debd8e9d51efaff4d4c2d99106041578943
RUN pip3 install --no-cache-dir sqlmap==1.8.12 websockets==12.0 \
    && curl -fsSL "https://github.com/projectdiscovery/nuclei/releases/download/v${NUCLEI_VERSION}/nuclei_${NUCLEI_VERSION}_linux_amd64.zip" -o /tmp/nuclei.zip \
    && echo "${NUCLEI_SHA256}  /tmp/nuclei.zip" | sha256sum -c - \
    && unzip -q /tmp/nuclei.zip nuclei -d /usr/local/bin \
    && chmod 0755 /usr/local/bin/nuclei \
    && rm -f /tmp/nuclei.zip

# Keep benchmark-critical no-op stages before optional heavyweight profiles.
# The legacy Docker builder still evaluates preceding stages for --target.
FROM base AS forensics

FROM web AS browser
RUN pip3 install --no-cache-dir playwright==1.49.1 && playwright install --with-deps chromium

FROM base AS reversing

FROM reversing AS windows
RUN dpkg --add-architecture i386 && apt-get update && apt-get install -y --no-install-recommends wine64 python3-pefile && rm -rf /var/lib/apt/lists/*

FROM base AS mobile
RUN apt-get update && apt-get install -y --no-install-recommends adb apktool jadx && rm -rf /var/lib/apt/lists/* \
    && pip3 install --no-cache-dir frida-tools==13.6.0 objection==1.11.0

FROM base AS crypto

FROM base AS cloud
RUN apt-get update && apt-get install -y --no-install-recommends kubectl helm && rm -rf /var/lib/apt/lists/* \
    && pip3 install --no-cache-dir awscli==1.36.40

FROM base AS password
RUN apt-get update && apt-get install -y --no-install-recommends hashcat john && rm -rf /var/lib/apt/lists/*

FROM browser AS osint
