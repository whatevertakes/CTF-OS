#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: ctf-jobs [OPTIONS] [JOB_ID]

Show bounded job status. With no JOB_ID, active jobs are shown by default.
At least one argument is required so accidental invocations return promptly.

Options:
  --json          Emit one schema_version=1 JSON document
  --all           Include terminal jobs
  --status STATE  Include only STATE (repeatable)
  --limit COUNT   Maximum jobs returned (default: 100; maximum: 1000)
  -h, --help      Show this help
EOF
}

die() {
    printf 'ctf-jobs: %s\n' "$*" >&2
    exit 2
}

if (($# == 0)); then
    usage
    exit 2
fi

json_mode=0
include_all=0
limit=100
job_id=""
statuses=()

while (($# > 0)); do
    case "$1" in
        --json)
            json_mode=1
            shift
            ;;
        --all)
            include_all=1
            shift
            ;;
        --status)
            (($# >= 2)) || die '--status requires a value'
            statuses+=("$2")
            shift 2
            ;;
        --limit)
            (($# >= 2)) || die '--limit requires a value'
            limit="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            die "unknown option: $1"
            ;;
        *)
            [[ -z "$job_id" ]] || die 'only one JOB_ID may be specified'
            job_id="$1"
            shift
            ;;
    esac
done

[[ "$limit" =~ ^[0-9]+$ ]] || die '--limit must be a positive integer'
((limit >= 1 && limit <= 1000)) || die '--limit must be between 1 and 1000'
if [[ -n "$job_id" && ! "$job_id" =~ ^job-[0-9]{8}$ ]]; then
    die 'invalid JOB_ID'
fi
for requested_status in "${statuses[@]}"; do
    case "$requested_status" in
        starting|running|completed|failed|timed_out|cancelled|lost) ;;
        *) die "invalid status: $requested_status" ;;
    esac
done

state_root="${CTF_STATE_ROOT:-/work/.ctf}"
[[ "$state_root" == /* ]] || die 'CTF_STATE_ROOT must be an absolute path'
jobs_root="${state_root%/}/jobs"
status_csv=""
if ((${#statuses[@]} > 0)); then
    status_csv="$(IFS=,; printf '%s' "${statuses[*]}")"
fi

python3 - "$jobs_root" "$json_mode" "$include_all" "$limit" "$job_id" \
    "$status_csv" <<'PY'
import datetime
import json
import os
import pathlib
import re
import stat
import sys

root_arg, json_mode, include_all, limit, requested_id, status_csv = sys.argv[1:]
root = pathlib.Path(root_arg)
limit = int(limit)
id_pattern = re.compile(r"^job-([0-9]{8})$")
terminal = {"completed", "failed", "timed_out", "cancelled", "lost"}
requested_statuses = set(filter(None, status_csv.split(",")))

def terminal_safe(value, limit):
    text = str(value)[:limit]
    output = []
    for character in text:
        codepoint = ord(character)
        if character in "\n\r\t":
            output.append(" ")
        elif (
            codepoint < 0x20
            or 0x7F <= codepoint <= 0x9F
            or not character.isprintable()
        ):
            if codepoint <= 0xFF:
                output.append(f"\\x{codepoint:02x}")
            elif codepoint <= 0xFFFF:
                output.append(f"\\u{codepoint:04x}")
            else:
                output.append(f"\\U{codepoint:08x}")
        else:
            output.append(character)
    return "".join(output)

def load_json(path):
    try:
        before = path.stat(follow_symlinks=False)
    except FileNotFoundError:
        return {}
    except OSError:
        return {"_ctf_invalid": True}
    try:
        if not stat.S_ISREG(before.st_mode) or before.st_size > 1024 * 1024:
            return {"_ctf_invalid": True}
        flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK
        flags |= getattr(os, "O_NOFOLLOW", 0)
        descriptor = os.open(path, flags)
        try:
            opened = os.fstat(descriptor)
            if (
                not stat.S_ISREG(opened.st_mode)
                or (opened.st_dev, opened.st_ino) != (before.st_dev, before.st_ino)
                or opened.st_size > 1024 * 1024
            ):
                return {"_ctf_invalid": True}
            data = os.read(descriptor, 1024 * 1024 + 1)
        finally:
            os.close(descriptor)
        if len(data) > 1024 * 1024:
            return {"_ctf_invalid": True}
        value = json.loads(data.decode("utf-8"))
        return value if isinstance(value, dict) else {"_ctf_invalid": True}
    except (OSError, UnicodeError, ValueError):
        return {"_ctf_invalid": True}

def process_matches(pid, ticks):
    if not isinstance(pid, int) or pid <= 1 or not isinstance(ticks, int):
        return False
    try:
        text = pathlib.Path(f"/proc/{pid}/stat").read_text()
        fields = text[text.rfind(")") + 2 :].split()
        return fields[0] not in {"Z", "X", "x"} and int(fields[19]) == ticks
    except (OSError, ValueError, IndexError):
        return False

def atomic_json(path, value):
    tmp = path.with_name(f"{path.name}.tmp.{os.getpid()}")
    with tmp.open("w", encoding="utf-8") as handle:
        json.dump(value, handle, ensure_ascii=False, sort_keys=True)
        handle.write("\n")
    os.replace(tmp, path)

if requested_id:
    directories = [root / requested_id]
    if not directories[0].is_dir() or directories[0].is_symlink():
        print(f"ctf-jobs: unknown job: {requested_id}", file=sys.stderr)
        raise SystemExit(3)
else:
    try:
        directories = [
            entry
            for entry in root.iterdir()
            if entry.is_dir() and not entry.is_symlink() and id_pattern.fullmatch(entry.name)
        ]
    except FileNotFoundError:
        directories = []
    directories.sort(key=lambda entry: int(entry.name[4:]), reverse=True)

jobs = []
now = datetime.datetime.now(datetime.timezone.utc)
for directory in directories:
    match = id_pattern.fullmatch(directory.name)
    if not match:
        continue
    meta = load_json(directory / "meta.json")
    status_path = directory / "status.json"
    status = load_json(status_path)
    invalid_status = bool(status.pop("_ctf_invalid", False))
    state = status.get("status", "lost")
    if invalid_status:
        status.update(
            {
                "schema_version": 1,
                "job_id": directory.name,
                "status": "lost",
                "finished_at": now.isoformat(),
                "exit_code": None,
                "timed_out": False,
                "cancelled": False,
            }
        )
        state = "lost"
        try:
            atomic_json(status_path, status)
        except OSError:
            pass
    elif state in {"starting", "running"}:
        pid = status.get("runner_pid")
        ticks = status.get("pid_start_ticks")
        is_recent_start = False
        if state == "starting":
            try:
                created = datetime.datetime.fromisoformat(meta.get("created_at", ""))
                is_recent_start = (now - created).total_seconds() < 2
            except (TypeError, ValueError):
                pass
        if not is_recent_start and not process_matches(pid, ticks):
            status["status"] = "lost"
            status["finished_at"] = now.isoformat()
            status["timed_out"] = False
            status["cancelled"] = False
            state = "lost"
            try:
                atomic_json(status_path, status)
            except OSError:
                pass

    if requested_statuses and state not in requested_statuses:
        continue
    if not requested_id and not int(include_all) and not requested_statuses and state in terminal:
        continue

    jobs.append(
        {
            "job_id": directory.name,
            "name": meta.get("name"),
            "status": state,
            "exit_code": status.get("exit_code"),
            "reason_code": status.get("reason_code"),
            "runner_pid": status.get("runner_pid"),
            "created_at": meta.get("created_at"),
            "started_at": status.get("started_at"),
            "finished_at": status.get("finished_at"),
            "timeout_seconds": meta.get("timeout_seconds"),
            "stdout_path": meta.get("stdout_path", str(directory / "stdout.log")),
            "stderr_path": meta.get("stderr_path", str(directory / "stderr.log")),
        }
    )
    if len(jobs) >= limit:
        break

payload = {
    "schema_version": 1,
    "kind": "job_list",
    "count": len(jobs),
    "jobs": jobs,
}
if json_mode == "1":
    print(json.dumps(payload, ensure_ascii=False, sort_keys=True))
else:
    if not jobs:
        print("No matching jobs.")
    else:
        print(f"{'JOB_ID':<13} {'STATUS':<10} {'EXIT':<5} {'PID':<8} NAME")
        for job in jobs:
            job_id = terminal_safe(job["job_id"], 20)
            status = terminal_safe(job["status"], 32)
            exit_code = terminal_safe(
                "-" if job["exit_code"] is None else job["exit_code"], 20
            )
            pid = terminal_safe(
                "-" if job["runner_pid"] is None else job["runner_pid"], 20
            )
            name = terminal_safe(job["name"] or "", 80)
            print(
                f"{job_id:<13} {status:<10} "
                f"{exit_code:<5} {pid:<8} {name}"
            )
PY
