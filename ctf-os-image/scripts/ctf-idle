#!/usr/bin/env python3
"""Signal-aware idle PID 1 with orphan child reaping."""

from __future__ import annotations

import argparse
import os
import signal
import sys
import threading


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(
        prog="ctf-idle",
        description="Keep a tool container alive and reap orphaned child processes.",
    )
    result.add_argument(
        "--serve",
        action="store_true",
        help="run until SIGTERM, SIGINT, or SIGHUP",
    )
    return result


def reap_children() -> None:
    while True:
        try:
            child_pid, _status = os.waitpid(-1, os.WNOHANG)
        except ChildProcessError:
            return
        except InterruptedError:
            continue
        if child_pid == 0:
            return


def main(argv: list[str]) -> int:
    cli = parser()
    if not argv:
        cli.print_usage(sys.stderr)
        return 2
    args = cli.parse_args(argv)
    if not args.serve:
        cli.print_usage(sys.stderr)
        return 2

    wake = threading.Event()
    stopping = False

    def request_stop(_signum: int, _frame: object) -> None:
        nonlocal stopping
        stopping = True
        wake.set()

    def child_changed(_signum: int, _frame: object) -> None:
        wake.set()

    signal.signal(signal.SIGTERM, request_stop)
    signal.signal(signal.SIGINT, request_stop)
    signal.signal(signal.SIGHUP, request_stop)
    signal.signal(signal.SIGCHLD, child_changed)

    while not stopping:
        reap_children()
        wake.wait(timeout=1.0)
        wake.clear()
    reap_children()
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
