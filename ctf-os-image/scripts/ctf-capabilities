#!/usr/bin/env python3
"""Probe the small managed-engine capability contract."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import stat
import subprocess
from pathlib import Path
from typing import Any


MANIFEST = Path("/tools/capabilities.json")
MAX_BYTES = 256 * 1024
MAX_ATTESTED_FILE_BYTES = 4 * 1024 * 1024
MAX_ASSET_FILES = 16
MAX_ASSET_MINIMUM_BYTES = 1024**4
_SHA256 = re.compile(r"^[0-9a-f]{64}$")
_MAGIC_HEX = re.compile(r"^(?:[0-9a-f]{2}){1,64}$")
_PYSAT_SOLVERS = frozenset({"cadical300", "kissat404"})


class CapabilityProbeError(RuntimeError):
    pass


def _probe_environment() -> dict[str, str]:
    environment = dict(os.environ)
    environment.update(
        {
            "HOME": "/tmp",
            "XDG_CACHE_HOME": "/tmp/ctf-capability-cache",
            "PYTHONDONTWRITEBYTECODE": "1",
        }
    )
    return environment


def _load() -> dict[str, Any]:
    flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK
    nofollow = getattr(os, "O_NOFOLLOW", 0)
    if not nofollow:
        raise CapabilityProbeError("O_NOFOLLOW support is required")
    flags |= nofollow
    descriptor = os.open(MANIFEST, flags)
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_size > MAX_BYTES:
            raise CapabilityProbeError("invalid capability manifest file")
        remaining = metadata.st_size
        chunks: list[bytes] = []
        while remaining:
            chunk = os.read(descriptor, min(65536, remaining))
            if not chunk:
                raise CapabilityProbeError("capability manifest was truncated")
            chunks.append(chunk)
            remaining -= len(chunk)
        if os.read(descriptor, 1):
            raise CapabilityProbeError("capability manifest changed while reading")
    finally:
        os.close(descriptor)
    raw = json.loads(b"".join(chunks).decode("utf-8"))
    if (
        not isinstance(raw, dict)
        or raw.get("schema_version") != 2
        or not isinstance(raw.get("capabilities"), list)
    ):
        raise CapabilityProbeError("unsupported capability manifest")
    return raw


def _probe(record: dict[str, Any]) -> dict[str, Any]:
    if not isinstance(record, dict):
        raise CapabilityProbeError("capability record must be an object")
    name = record.get("name")
    kind = record.get("kind")
    if not isinstance(name, str) or not name:
        raise CapabilityProbeError("capability requires name")
    if kind == "file_sha256":
        return _probe_file_sha256(name, record)
    if kind == "regular_file_set":
        return _probe_regular_file_set(name, record)

    command = record.get("command")
    if not isinstance(command, str):
        raise CapabilityProbeError(
            f"capability {name} requires command"
        )
    if not Path(command).is_file() or not os.access(command, os.X_OK):
        return {"name": name, "available": False}
    if kind == "command":
        arguments = record.get("arguments", [])
        if not isinstance(arguments, list) or not all(
            isinstance(value, str) for value in arguments
        ):
            raise CapabilityProbeError(f"invalid arguments for {name}")
        argv = [command, *arguments]
    elif kind == "python_module":
        module = record.get("module")
        if not isinstance(module, str) or not module.replace("_", "").isalnum():
            raise CapabilityProbeError(f"invalid module for {name}")
        argv = [
            command,
            "-c",
            "import importlib; importlib.import_module(" + repr(module) + ")",
        ]
    elif kind == "pysat_solver":
        solver = record.get("solver")
        if solver not in _PYSAT_SOLVERS:
            raise CapabilityProbeError(f"invalid PySAT solver for {name}")
        argv = [
            command,
            "-c",
            (
                "from pysat.solvers import Solver\n"
                f"s=Solver(name={solver!r},bootstrap_with=[[1],[-1,2]])\n"
                "assert s.solve() and s.get_model()\n"
                "s.delete()\n"
                f"s=Solver(name={solver!r},bootstrap_with=[[1],[-1]])\n"
                "assert not s.solve()\n"
                "s.delete()\n"
            ),
        ]
    elif kind == "dimacs_solver":
        arguments = record.get("arguments", [])
        if not isinstance(arguments, list) or not all(
            isinstance(value, str) for value in arguments
        ):
            raise CapabilityProbeError(f"invalid arguments for {name}")
        try:
            result = subprocess.run(
                [command, *arguments],
                input=b"p cnf 2 2\n1 0\n-1 2 0\n",
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                env=_probe_environment(),
                check=False,
                timeout=10,
            )
        except (OSError, subprocess.TimeoutExpired):
            return {"name": name, "available": False}
        return {
            "name": name,
            "available": (
                result.returncode == 10
                and b"s SATISFIABLE" in (result.stdout or b"")[:65536]
            ),
        }
    else:
        raise CapabilityProbeError(f"invalid capability kind for {name}")
    try:
        result = subprocess.run(
            argv,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            env=_probe_environment(),
            check=False,
            timeout=10,
        )
    except (OSError, subprocess.TimeoutExpired):
        return {"name": name, "available": False}
    return {"name": name, "available": result.returncode == 0}


def _probe_regular_file_set(
    name: str,
    record: dict[str, Any],
) -> dict[str, Any]:
    files = record.get("files")
    if (
        not isinstance(files, list)
        or not files
        or len(files) > MAX_ASSET_FILES
    ):
        raise CapabilityProbeError(f"invalid asset file set for {name}")
    available = True
    for item in files:
        if not isinstance(item, dict):
            raise CapabilityProbeError(f"invalid asset file for {name}")
        path = item.get("path")
        minimum_bytes = item.get("minimum_bytes")
        magic_hex = item.get("magic_hex")
        if (
            not isinstance(path, str)
            or not path.startswith("/")
            or "\x00" in path
            or ".." in Path(path).parts
            or type(minimum_bytes) is not int
            or not 1 <= minimum_bytes <= MAX_ASSET_MINIMUM_BYTES
            or (
                magic_hex is not None
                and (
                    not isinstance(magic_hex, str)
                    or _MAGIC_HEX.fullmatch(magic_hex) is None
                )
            )
        ):
            raise CapabilityProbeError(f"invalid asset file for {name}")
        magic = bytes.fromhex(magic_hex) if magic_hex is not None else b""
        if not _stable_regular_file_prefix(path, minimum_bytes, magic):
            available = False
    return {"name": name, "available": available}


def _stable_regular_file_prefix(
    path: str,
    minimum_bytes: int,
    magic: bytes,
) -> bool:
    flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK
    nofollow = getattr(os, "O_NOFOLLOW", 0)
    if not nofollow:
        return False
    descriptor: int | None = None
    try:
        descriptor = os.open(path, flags | nofollow)
        before = os.fstat(descriptor)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_nlink < 1
            or before.st_size < minimum_bytes
            or os.read(descriptor, len(magic)) != magic
        ):
            return False
        after = os.fstat(descriptor)
        identity = (
            "st_dev",
            "st_ino",
            "st_mode",
            "st_nlink",
            "st_size",
            "st_mtime_ns",
            "st_ctime_ns",
        )
        return all(
            getattr(before, field) == getattr(after, field)
            for field in identity
        )
    except OSError:
        return False
    finally:
        if descriptor is not None:
            try:
                os.close(descriptor)
            except OSError:
                pass


def _probe_file_sha256(
    name: str,
    record: dict[str, Any],
) -> dict[str, Any]:
    path = record.get("path")
    schema_version = record.get("attestation_schema_version")
    contract_id = record.get("contract_id")
    contract_version = record.get("contract_version")
    expected_sha256 = record.get("sha256")
    if (
        not isinstance(path, str)
        or not path.startswith("/")
        or "\x00" in path
        or ".." in Path(path).parts
        or type(schema_version) is not int
        or schema_version != 1
        or not isinstance(contract_id, str)
        or not contract_id
        or type(contract_version) is not int
        or contract_version < 1
        or not isinstance(expected_sha256, str)
        or _SHA256.fullmatch(expected_sha256) is None
    ):
        raise CapabilityProbeError(
            f"invalid file attestation for {name}"
        )

    actual_sha256 = _stable_regular_file_sha256(path)
    output: dict[str, Any] = {
        "name": name,
        "available": actual_sha256 == expected_sha256,
    }
    if actual_sha256 is not None:
        output["attestation"] = {
            "schema_version": schema_version,
            "contract_id": contract_id,
            "contract_version": contract_version,
            "path": path,
            "sha256": actual_sha256,
        }
    return output


def _stable_regular_file_sha256(path: str) -> str | None:
    flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK
    nofollow = getattr(os, "O_NOFOLLOW", 0)
    if not nofollow:
        return None
    descriptor: int | None = None
    try:
        descriptor = os.open(path, flags | nofollow)
        before = os.fstat(descriptor)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_nlink < 1
            or not 0 <= before.st_size <= MAX_ATTESTED_FILE_BYTES
        ):
            return None
        digest = hashlib.sha256()
        remaining = before.st_size
        while remaining:
            chunk = os.read(descriptor, min(65536, remaining))
            if not chunk:
                return None
            digest.update(chunk)
            remaining -= len(chunk)
        if os.read(descriptor, 1):
            return None
        after = os.fstat(descriptor)
        identity = (
            "st_dev",
            "st_ino",
            "st_mode",
            "st_nlink",
            "st_size",
            "st_mtime_ns",
            "st_ctime_ns",
        )
        if any(
            getattr(before, field) != getattr(after, field)
            for field in identity
        ):
            return None
        return digest.hexdigest()
    except OSError:
        return None
    finally:
        if descriptor is not None:
            try:
                os.close(descriptor)
            except OSError:
                pass


def main() -> int:
    parser = argparse.ArgumentParser(prog="ctf-capabilities")
    parser.add_argument("--json", action="store_true", required=True)
    parser.parse_args()
    try:
        raw = _load()
        output = {
            "schema_version": 2,
            "capabilities": [_probe(item) for item in raw["capabilities"]],
        }
    except (CapabilityProbeError, OSError, UnicodeError, json.JSONDecodeError) as error:
        print(str(error), file=os.sys.stderr)
        return 2
    print(
        json.dumps(
            output,
            ensure_ascii=True,
            allow_nan=False,
            separators=(",", ":"),
            sort_keys=True,
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
