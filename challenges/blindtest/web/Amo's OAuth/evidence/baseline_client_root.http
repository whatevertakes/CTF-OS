<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Demo Client App</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
      body { font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; margin: 2rem; }
      .card { max-width: 740px; margin: 0 auto; padding: 1.4rem 1.6rem; border: 1px solid #eee; border-radius: 12px; box-shadow: 0 2px 10px rgba(0,0,0,.05); }
      h1 { margin: 0 0 1rem 0; }
      a.button, button { display: inline-block; padding: .7rem 1rem; background: #111; color: #fff; border-radius: 10px; text-decoration: none; }
      code { background: #f6f8fa; padding: .15rem .35rem; border-radius: 6px; }
      pre { background: #f6f8fa; padding: .7rem; border-radius: 8px; overflow-x: auto; }
      table { width: 100%; border-collapse: collapse; margin: .8rem 0; }
      td, th { border-bottom: 1px solid #eee; text-align: left; padding: .5rem; }
      .btns a { margin-right: .5rem; }
      input[type="text"] { width: 100%; padding: .6rem; margin: .5rem 0; border-radius: 8px; border: 1px solid #ddd; }
      .row { display: flex; flex-direction: column; gap: 20px; }
      .form-block { display: flex; flex-direction: column; }
      .muted { color:#666; font-size:.9rem; }
    </style>
  </head>
  <body>
    <div class="card">
      <h1>Client App</h1>
      <p>This app demonstrates the <code>Authorization Code</code> flow.</p>

      <div class="row">
        <form method="POST" action="/set-auth-server" class="form-block">
          <label for="authServerUrl">Auth Server URL</label>
          <input
            type="text"
            id="authServerUrl"
            name="authServerUrl"
            value="http://auth-server:4000"
            placeholder="Enter auth URL"
          />
          <button type="submit">Save Auth Server URL</button>
        </form>
      
        <form method="POST" action="/set-client-url" class="form-block">
          <label for="clientAppUrl">Client App URL</label>
          <input
            type="text"
            id="clientAppUrl"
            name="clientAppUrl"
            value="https://lepgvfg.request.dreamhack.games"
            placeholder="Enter client URL"
          />
          <button type="submit">Save Client App URL</button>
        </form>
      </div>

      
        <p>Current Auth Server: <code>http://auth-server:4000</code></p>
      
      
        <p>Current Client URL: <code>https://lepgvfg.request.dreamhack.games</code></p>
      

      
        <p><a class="button" href="/login">Login with Demo OAuth</a></p>
      

      

      
    </div>
  </body>
</html>
