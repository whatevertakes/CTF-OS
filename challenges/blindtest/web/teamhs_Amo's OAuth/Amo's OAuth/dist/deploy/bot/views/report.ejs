<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Bot</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
      body { font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; margin: 2rem; }
      .card { padding: 1.2rem; border: 1px solid #eee; border-radius: 12px; max-width: 680px; margin: 0 auto; box-shadow: 0 2px 10px rgba(0,0,0,.05); }
      input, button { width: 100%; padding: .6rem .7rem; margin: .4rem 0; border-radius: 8px; border: 1px solid #ddd; }
      button { background: #111; color: #fff; border: none; cursor: pointer; }
      pre { background: #f6f8fa; padding: .8rem; border-radius: 8px; overflow-x: auto; }
      .muted { color: #666; }
    </style>
  </head>
  <body>
    <div class="card">
      <h1>Bot</h1>

      <form method="POST" action="/report">
        <label>URL</label>
        <input type="text" name="url" value="<%= defaultUrl || '' %>" placeholder="http://client-app:3000/login" required />
        <button type="submit">Access</button>
      </form>

      <% if (result) { %>
        <h2>Result</h2>
        <p><strong>Success:</strong> <%= result.success %></p>
      <% } %>
    </div>
  </body>
</html>
