:root {
  color: #f6f8ff;
  background: #080a11;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-synthesis: none;
}

* {
  box-sizing: border-box;
}

body {
  min-height: 100vh;
  margin: 0;
  background:
    radial-gradient(circle at 15% 10%, rgba(105, 92, 255, 0.18), transparent 32rem),
    radial-gradient(circle at 90% 85%, rgba(0, 220, 180, 0.12), transparent 28rem),
    #080a11;
}

button,
input {
  font: inherit;
}

.shell {
  width: min(760px, calc(100% - 32px));
  margin: 0 auto;
  padding: 72px 0 40px;
}

header {
  margin-bottom: 32px;
}

.eyebrow {
  margin: 0 0 12px;
  color: #8bf5dc;
  font: 700 0.75rem/1.2 ui-monospace, SFMono-Regular, Menlo, monospace;
  letter-spacing: 0.16em;
}

h1 {
  margin: 0;
  font-size: clamp(2.2rem, 8vw, 4.8rem);
  line-height: 0.96;
  letter-spacing: -0.055em;
}

.subtitle {
  max-width: 610px;
  margin: 20px 0 0;
  color: #a9b0c2;
  font-size: 1rem;
  line-height: 1.7;
}

.status-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border: 1px solid #262a37;
  border-radius: 14px 14px 0 0;
  overflow: hidden;
  background: rgba(15, 18, 29, 0.82);
}

.metric {
  display: grid;
  gap: 8px;
  padding: 18px 20px;
  border-right: 1px solid #262a37;
}

.metric:last-child {
  border-right: 0;
}

.metric-label {
  color: #747c91;
  font: 700 0.68rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
  letter-spacing: 0.12em;
}

.metric strong {
  font: 700 1.25rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
}

.muted {
  color: #4e5568;
}

.challenge-card {
  min-height: 390px;
  padding: clamp(24px, 6vw, 48px);
  border: 1px solid #262a37;
  border-top: 0;
  border-radius: 0 0 14px 14px;
  background: rgba(11, 14, 23, 0.92);
  box-shadow: 0 28px 80px rgba(0, 0, 0, 0.36);
}

.idle-panel {
  display: grid;
  min-height: 290px;
  place-content: center;
  justify-items: center;
  gap: 24px;
  text-align: center;
  color: #a9b0c2;
}

.idle-panel p {
  margin: 0;
}

button {
  min-height: 46px;
  padding: 0 22px;
  border-radius: 9px;
  border: 0;
  cursor: pointer;
  font-weight: 750;
  transition: transform 120ms ease, opacity 120ms ease, background 120ms ease;
}

button:hover:not(:disabled) {
  transform: translateY(-1px);
}

button:disabled {
  cursor: not-allowed;
  opacity: 0.45;
}

.primary {
  color: #080a11;
  background: #8bf5dc;
}

.primary:hover:not(:disabled) {
  background: #a1ffe9;
}

.secondary {
  width: 100%;
  margin-top: 14px;
  color: #e7eaff;
  border: 1px solid #394055;
  background: #171b29;
}

.image-frame {
  display: grid;
  min-height: 220px;
  padding: 18px;
  place-items: center;
  border-radius: 12px;
  background: #f3efe6;
  overflow: hidden;
}

.image-frame img {
  width: 100%;
  max-width: 600px;
  height: auto;
  image-rendering: auto;
}

#image-placeholder {
  color: #5f6470;
  font: 600 0.82rem/1.4 ui-monospace, SFMono-Regular, Menlo, monospace;
}

form {
  margin-top: 24px;
}

label {
  display: block;
  margin-bottom: 10px;
  color: #a9b0c2;
  font-size: 0.82rem;
  font-weight: 650;
}

.answer-row {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 10px;
}

input {
  width: 100%;
  min-width: 0;
  height: 50px;
  padding: 0 16px;
  color: #f7f8ff;
  border: 1px solid #353b4e;
  border-radius: 9px;
  outline: none;
  background: #111522;
  font: 700 1.05rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
  letter-spacing: 0.08em;
}

input:focus {
  border-color: #8bf5dc;
  box-shadow: 0 0 0 3px rgba(139, 245, 220, 0.12);
}

.message {
  min-height: 24px;
  margin: 18px 0 0;
  color: #a9b0c2;
  font: 650 0.9rem/1.5 ui-monospace, SFMono-Regular, Menlo, monospace;
}

.message.success {
  color: #8bf5dc;
}

.message.error {
  color: #ff8194;
}

.flag {
  margin: 18px 0 0;
  padding: 18px;
  color: #8bf5dc;
  border: 1px solid rgba(139, 245, 220, 0.35);
  border-radius: 9px;
  background: rgba(139, 245, 220, 0.06);
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}

footer {
  margin-top: 22px;
  color: #666e82;
  font-size: 0.82rem;
  text-align: center;
}

a {
  color: #8bf5dc;
}

.hidden {
  display: none !important;
}

@media (max-width: 560px) {
  .shell {
    padding-top: 40px;
  }

  .status-grid {
    grid-template-columns: 1fr 1fr;
  }

  .connection {
    grid-column: 1 / -1;
    border-top: 1px solid #262a37;
  }

  .metric:nth-child(2) {
    border-right: 0;
  }

  .answer-row {
    grid-template-columns: 1fr;
  }
}
