  "exploit_architecture": [
    "create DreamHack Request Bin host under *.request.dreamhack.games",
    "set client app process-global callback base to the Request Bin",
    "set client app auth server URL back to http://auth-server:4000",
    "submit http://client-app:3000/login to the admin bot",
    "capture admin authorization code from the Request Bin callback",
    "redeem captured code through a fresh client session without a state parameter",
    "call the protected resource API through the client app"
  ],
  "design_lessons": [
    "separate mutable process-global OAuth configuration from per-session state",
    "record state-changing remote requests in a mutation ledger",
    "keep negative probes and ordinary callback failures as Level 3 worker evidence",
    "compare independent solves by invariant proof fields rather than fresh request-bin hostnames or one-use codes",
    "keep raw sensitive evidence local while preserving redacted summaries and stable hashes"
  ],
